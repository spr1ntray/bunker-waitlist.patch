{
  "$schema": "https://soft-hub.local/schemas/plugin-v1.json",
  "schema_version": 1,
  "contract_version": "SH-SOFTWARE-0.6/4",
  "id": "io.sprintray.bunker-waitlist",
  "name": "BUNKER",
  "version": "1.2.8",
  "description": "Waitlist BUNKER и WL-минт. Один кошелёк — один proxy.",
  "author": "sprintray",
  "presentation": {
    "display_name": "BUNKER",
    "description": "Пишет waitlist и сам минтит WL. Продажу не трогает. Один кошелёк — один proxy.",
    "assets": {
      "icon": "assets/icon.png",
      "image": "assets/image.png"
    }
  },
  "catalog": {
    "sections": [
      "nft"
    ]
  },
  "compatibility": {
    "hub": ">=0.6.15",
    "python": ">=3.12,<3.13",
    "os": [
      "darwin"
    ]
  },
  "runtime": {
    "type": "python",
    "entrypoint": "plugin.main:run",
    "protocol": "soft-hub-jsonl/1",
    "state_model": "externally_reconciled",
    "requirements": "requirements.txt",
    "safe_stop": true,
    "heartbeat_seconds": 15
  },
  "permissions": {
    "secrets": [
      "evm_private_key",
      "proxy"
    ],
    "network": [
      "thebunkerhood.com",
      "api.opensea.io",
      "opensea.io",
      "rpc.mainnet.chain.robinhood.com"
    ],
    "chains": [
      4663
    ],
    "financial_risk": "mainnet",
    "browser": false,
    "local_services": []
  },
  "actions": [
    {
      "id": "register_waitlist",
      "name": "Записать в waitlist",
      "description": "Закрывает квесты и отправляет кошелёк, класс и X-хэндл в waitlist BUNKER.",
      "risk": "external_write",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": [
          "proxy"
        ]
      },
      "resources": {
        "account": [
          "proxy"
        ],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Регистрация BUNKER",
        "primary_kind": "account_snapshot",
        "columns": [
          {
            "key": "outcome",
            "title": "Итог",
            "type": "string"
          },
          {
            "key": "class_name",
            "title": "Класс",
            "type": "string"
          },
          {
            "key": "x_handle",
            "title": "X",
            "type": "string"
          },
          {
            "key": "queued",
            "title": "В очереди",
            "type": "boolean"
          }
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько профилей софт обрабатывает одновременно. Один кошелёк всегда идёт через свой proxy.",
            "default": 3,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          },
          "class_choice": {
            "type": "string",
            "title": "Класс бункера",
            "description": "Какой класс записать. «Случайно» выбирает класс по адресу кошелька: один адрес всегда получает тот же класс.",
            "enum": [
              "random",
              "worker",
              "farmer",
              "mechanic",
              "it",
              "administration"
            ],
            "default": "random",
            "x-ui": {
              "group": "Класс",
              "order": 10,
              "enum_labels": {
                "random": "Случайно по кошелькам",
                "worker": "WORKER — производство",
                "farmer": "FARMER — ресурсы",
                "mechanic": "MECHANIC — ремонт",
                "it": "IT — системы",
                "administration": "ADMINISTRATION — координация"
              }
            }
          },
          "account_pause_min_ms": {
            "type": "integer",
            "title": "Пауза аккаунта",
            "description": "Случайная пауза перед каждым кошельком. Нижняя и верхняя границы задают диапазон.",
            "default": 800,
            "minimum": 0,
            "maximum": 30000,
            "multipleOf": 50,
            "x-ui": {
              "group": "Темп",
              "order": 20,
              "unit": "мс",
              "control": "dual_range",
              "range": {
                "id": "account_pause",
                "role": "from"
              }
            }
          },
          "account_pause_max_ms": {
            "type": "integer",
            "title": "Пауза аккаунта",
            "description": "Случайная пауза перед каждым кошельком. Нижняя и верхняя границы задают диапазон.",
            "default": 2000,
            "minimum": 0,
            "maximum": 30000,
            "multipleOf": 50,
            "x-ui": {
              "group": "Темп",
              "order": 30,
              "unit": "мс",
              "control": "dual_range",
              "range": {
                "id": "account_pause",
                "role": "to"
              }
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Таймаут запроса",
            "description": "Фиксированный сетевой таймаут proxy и API BUNKER. Безопасное значение — 30.",
            "default": 30,
            "minimum": 5,
            "maximum": 120,
            "multipleOf": 1,
            "x-ui": {
              "group": "Сеть",
              "order": 40,
              "unit": "сек",
              "advanced": true
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "mint",
      "name": "Минт",
      "description": "Сам ждёт allowlist и минтит только WL. Можно оставить работать надолго. Продажу не ставит.",
      "risk": "mainnet_write",
      "account_mode": "one_or_more",
      "confirmation_phrase": "BUNKER MINT",
      "permissions": {
        "secrets": [
          "evm_private_key",
          "proxy"
        ]
      },
      "resources": {
        "account": [
          "private_key",
          "proxy"
        ],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Минт BUNKER",
        "primary_kind": "account_mint",
        "columns": [
          {
            "key": "outcome",
            "title": "Итог",
            "type": "string"
          },
          {
            "key": "stage",
            "title": "Стадия",
            "type": "string"
          },
          {
            "key": "minted",
            "title": "Сминтил",
            "type": "boolean"
          },
          {
            "key": "token_id",
            "title": "Token",
            "type": "string"
          },
          {
            "key": "tx_hash",
            "title": "Tx",
            "type": "string"
          }
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько кошельков минтить сразу, когда WL откроется.",
            "default": 5,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {
              "group": "Выполнение",
              "order": 0,
              "unit": "аккаунтов"
            }
          },
          "watch_minutes": {
            "type": "integer",
            "title": "Ждать WL",
            "description": "Сколько минут софт сам ждёт WL. Можно оставить на ночь — до 7 суток.",
            "default": 720,
            "minimum": 5,
            "maximum": 10080,
            "multipleOf": 1,
            "x-ui": {
              "group": "Ожидание",
              "order": 10,
              "unit": "мин"
            }
          },
          "poll_interval_seconds": {
            "type": "integer",
            "title": "Интервал опроса",
            "description": "Как часто проверять, открылся ли WL. Безопасное значение — 3 секунды.",
            "default": 3,
            "minimum": 2,
            "maximum": 60,
            "multipleOf": 1,
            "x-ui": {
              "group": "Ожидание",
              "order": 20,
              "unit": "сек"
            }
          },
          "max_mint_eth": {
            "type": "string",
            "title": "Потолок минта",
            "description": "0 — только бесплатный WL, платите газ. Больше нуля — максимальная цена WL в ETH. Дороже пропускаем.",
            "default": "0",
            "maxLength": 24,
            "x-ui": {
              "group": "Минт",
              "order": 25,
              "placeholder": "0"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Таймаут запроса",
            "description": "Сетевой таймаут proxy, RPC и OpenSea. Безопасное значение — 30.",
            "default": 30,
            "minimum": 5,
            "maximum": 120,
            "multipleOf": 1,
            "x-ui": {
              "group": "Сеть",
              "order": 30,
              "unit": "сек",
              "advanced": true
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "ui": {
    "accent": "#FF9B32",
    "monogram": "BK"
  }
}
